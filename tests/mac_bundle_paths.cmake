# Exercise the install hook without requiring macOS tools. Only the path and
# signing orchestration are mocked; the installed template runs unchanged.
set(test_dir "${CMAKE_CURRENT_BINARY_DIR}/mac bundle path test")
file(MAKE_DIRECTORY "${test_dir}/modules")
file(WRITE "${test_dir}/modules/BundleUtilities.cmake" [=[
function(fixup_bundle bundle libraries directories)
    if(NOT IS_ABSOLUTE "${bundle}")
        message(FATAL_ERROR "BundleUtilities received a relative path: ${bundle}")
    endif()
    if(NOT bundle STREQUAL expected_bundle)
        message(FATAL_ERROR "Wrong bundle path: ${bundle}; expected ${expected_bundle}")
    endif()
endfunction()
]=])
set(CMAKE_MODULE_PATH "${test_dir}/modules")
set(CODESIGN_EXECUTABLE "${CMAKE_COMMAND}")
function(execute_process)
    cmake_parse_arguments(sign "" "RESULT_VARIABLE;ERROR_VARIABLE" "COMMAND" ${ARGN})
    if(NOT sign_COMMAND MATCHES "--force;--sign;-|--verify;--deep;--strict")
        message(FATAL_ERROR "Unexpected signing command: ${sign_COMMAND}")
    endif()
    set("${sign_RESULT_VARIABLE}" 0 PARENT_SCOPE)
    set("${sign_ERROR_VARIABLE}" "" PARENT_SCOPE)
endfunction()
set(saved_destdir "$ENV{DESTDIR}")
set(ENV{DESTDIR} "")
set(CMAKE_INSTALL_PREFIX "relative stage")
get_filename_component(expected_bundle "relative stage/reckless_drivin.app" ABSOLUTE)
include("${SOURCE_DIR}/cmake/InstallMacBundle.cmake.in")
set(CMAKE_INSTALL_PREFIX "${test_dir}/absolute stage")
set(expected_bundle "${CMAKE_INSTALL_PREFIX}/reckless_drivin.app")
include("${SOURCE_DIR}/cmake/InstallMacBundle.cmake.in")
set(ENV{DESTDIR} "${test_dir}/package")
set(CMAKE_INSTALL_PREFIX "/Applications")
set(expected_bundle "$ENV{DESTDIR}/Applications/reckless_drivin.app")
include("${SOURCE_DIR}/cmake/InstallMacBundle.cmake.in")
set(ENV{DESTDIR} "${saved_destdir}")
file(REMOVE_RECURSE "${test_dir}")
