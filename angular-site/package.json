{
  "name": "reckless-drivin",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint --config eslint.config.mjs 'src/**/*.ts'",
    "generate:lua-api": "node ../scripts/generate-lua-api.mjs",
    "check:lua-api": "pnpm run generate:lua-api && node ../scripts/check-lua-api-contract.mjs",
    "ng": "ng",
    "sync:dev-assets": "node ../scripts/sync-angular-dev-assets.mjs",
    "prestart": "pnpm run sync:dev-assets",
    "start": "ng serve",
    "dev": "ng server",
    "prestart:repo": "pnpm run sync:dev-assets",
    "start:repo": "ng serve --serve-path /RecklessDrivinPort/",
    "prebuild": "pnpm run sync:dev-assets && pnpm run generate:lua-api",
    "build": "ng build",
    "prewatch": "pnpm run sync:dev-assets",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:storybook": "playwright test --config=playwright.storybook.config.ts",
    "storybook": "ng run reckless-drivin:storybook",
    "build-storybook": "ng run reckless-drivin:build-storybook",
    "storybook:screenshots": "node ../scripts/capture-storybook-screenshots.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@angular/animations": "^21.2.2",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.2",
    "@angular/compiler": "^21.2.2",
    "@angular/core": "^21.2.2",
    "@angular/forms": "^21.2.2",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.2.2",
    "@angular/router": "^21.2.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lachlanbwwright/rsrcdump-ts": "^1.0.6",
    "@types/luaparse": "^0.2.13",
    "fflate": "^0.8.3",
    "konva": "^10.2.0",
    "luaparse": "^0.3.1",
    "neverthrow": "^8.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
    "@angular-devkit/architect": "^0.2102.2",
    "@angular-devkit/build-angular": "^21.2.2",
    "@angular-devkit/core": "^21.2.2",
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.2",
    "@chromatic-com/storybook": "latest",
    "@compodoc/compodoc": "latest",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/angular-vite": "^10.5.10",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-neverthrow": "^1.1.4",
    "eslint-plugin-storybook": "^10.5.10",
    "jsdom": "^28.0.0",
    "playwright": "latest",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vite": "latest",
    "vitest": "^4.0.8"
  }
}
